{
  "cleanUrls": true,
  "trailingSlash": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/lembretes/",
      "destination": "/blink/",
      "permanent": true
    },
    {
      "source": "/lembretes/obrigado/",
      "destination": "/blink/obrigado/",
      "permanent": true
    }
  ]
}
